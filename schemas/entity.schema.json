{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product entity",
  "type": "object",
  "required": [
    "id",
    "name",
    "kind",
    "status",
    "applies_to",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_review",
        "verified",
        "withdrawn"
      ]
    },
    "applies_to": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
