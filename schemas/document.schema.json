{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Screenberry knowledge document",
  "type": "object",
  "required": [
    "id",
    "variant_id",
    "title",
    "language",
    "kind",
    "status",
    "owner",
    "applies_to",
    "verified_in",
    "last_verified",
    "evidence",
    "aliases",
    "related"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "variant_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "enum": [
        "en",
        "ja"
      ],
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "concepts",
        "reference",
        "how-to",
        "tutorials",
        "troubleshooting",
        "known-issues",
        "compatibility",
        "release-notes",
        "glossary"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_review",
        "verified",
        "withdrawn"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "applies_to": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Version applicability",
      "type": "object",
      "required": [
        "from",
        "until_exclusive"
      ],
      "properties": {
        "from": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$"
        },
        "until_exclusive": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$"
        }
      },
      "additionalProperties": true
    },
    "verified_in": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "last_verified": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "publication": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Legacy publication provenance",
      "type": "object",
      "required": [
        "profile",
        "product_version",
        "role"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "product_version": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "guide",
            "legal",
            "historical"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
